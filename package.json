{
  "name": "improv-assist-frontend",
  "version": "1.0.0-beta.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "docker:dev": "docker compose -f docker/docker-compose.yml --env-file .env up -d",
    "docker:dev:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "docker:dev:build": "docker compose -f docker/docker-compose.yml --env-file .env build",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml --env-file .env up -d",
    "docker:prod:down": "docker compose -f docker/docker-compose.prod.yml --env-file .env down"
  },
  "dependencies": {
    "next": "^15.1.0",
