FROM node:20-alpine

# Fix system vulnerabilities (CVEs)
RUN apk update && apk upgrade --no-cache

WORKDIR /app

# Copy dependency definitions first for optimal caching
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install

# Copy configuration and code (HMR volumes will mount over this in compose)
COPY . .

EXPOSE 3000

# Next.js telemetry disable
ENV NEXT_TELEMETRY_DISABLED=1

CMD ["npm", "run", "dev"]
