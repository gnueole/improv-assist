#!/usr/bin/env bash
# ==============================================================================
# 🎭 HOUBA HOUBA ! — SCRIPT DE CONFIGURATION
# ==============================================================================
# Description : Vérifie les dépendances système, initialise les fichiers .env
#               et installe les paquets de dépendances requis.
# Author      : Éole <hi@eole.me>
# License     : MIT
# ==============================================================================

# Interrompt le script en cas d'erreur
set -e

# Couleurs pour le terminal
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # Pas de couleur
BOLD='\033[1m'

# Helpers de log
log_success() { echo -e "${GREEN}✔ $1${NC}"; }
log_warn() { echo -e "${YELLOW}⚠ $1${NC}"; }
log_error() { echo -e "${RED}✘ $1${NC}"; }
log_info() { echo -e "${BLUE}ℹ $1${NC}"; }

# Options en ligne de commande
AUTO_INSTALL=false
for arg in "$@"; do
    case $arg in
        -y|--non-interactive|--auto)
            AUTO_INSTALL=true
            shift
            ;;
    esac
done

echo -e "${BOLD}======================================================================"
echo -e "          🐸  HOUBA HOUBA ! — CONFIGURATION SYSTÈME  🐸"
echo -e "======================================================================${NC}"
echo ""

# 1. Vérification des dépendances système
log_info "Vérification des dépendances requises..."

# Node.js
if command -v node >/dev/null 2>&1; then
    NODE_VERSION=$(node -v | cut -d'v' -f2)
    NODE_MAJOR=$(echo "$NODE_VERSION" | cut -d'.' -f1)
    if [ "$NODE_MAJOR" -lt 20 ]; then
        log_warn "Node.js est installé (v$NODE_VERSION) mais la version 20+ est vivement recommandée."
    else
        log_success "Node.js est installé : v$NODE_VERSION"
    fi
else
    log_error "Node.js n'est pas détecté. Veuillez installer Node.js v20+ pour lancer l'application Next.js."
fi

# npm
if command -v npm >/dev/null 2>&1; then
    NPM_VERSION=$(npm -v)
    log_success "npm est installé : v$NPM_VERSION"
else
    log_error "npm n'est pas détecté."
fi

# Docker
if command -v docker >/dev/null 2>&1; then
    DOCKER_VERSION=$(docker --version | awk '{print $3}' | sed 's/,//')
    log_success "Docker est installé : v$DOCKER_VERSION"
else
    log_warn "Docker n'est pas détecté. Requis pour exécuter l'environnement de dev conteneurisé."
fi

# Docker Compose
if docker compose version >/dev/null 2>&1; then
    log_success "Docker Compose est disponible (docker compose)"
elif command -v docker-compose >/dev/null 2>&1; then
    log_success "Docker Compose est disponible (docker-compose)"
else
    log_warn "Docker Compose n'est pas détecté. Requis pour les raccourcis de développement locaux."
fi

# Python 3 & requests
if command -v python3 >/dev/null 2>&1; then
    PYTHON_VERSION=$(python3 --version | awk '{print $2}')
    log_success "Python 3 est installé : v$PYTHON_VERSION"
    
    if python3 -c "import requests" >/dev/null 2>&1; then
        log_success "Bibliothèque Python 'requests' est présente."
    else
        log_warn "La bibliothèque Python 'requests' est manquante."
        if [ "$AUTO_INSTALL" = true ]; then
            log_info "Installation automatique des packages Python requis..."
            pip3 install -r scripts/requirements.txt || pip install -r scripts/requirements.txt || log_warn "Échec de l'installation automatique. Lancez manuellement : pip install -r scripts/requirements.txt"
        else
            read -p "Voulez-vous installer les dépendances Python (requests) maintenant ? [O/n] " -n 1 -r
            echo ""
            if [[ $REPLY =~ ^[Oo]$ ]] || [[ -z $REPLY ]]; then
                pip3 install -r scripts/requirements.txt || pip install -r scripts/requirements.txt || log_warn "Échec de l'installation. Lancez manuellement : pip install -r scripts/requirements.txt"
            else
                log_warn "Installation des dépendances Python ignorée."
            fi
        fi
    fi
else
    log_warn "Python 3 n'est pas installé. Requis pour le script d'import populate_reservoir.py."
fi

echo ""
# 2. Initialisation du fichier d'environnement
log_info "Configuration des fichiers d'environnement..."

if [ ! -f ".env" ]; then
    log_warn "Le fichier de configuration .env est introuvable."
    if [ -f ".env.example" ]; then
        cp .env.example .env
        log_success "Fichier .env initialisé avec succès depuis .env.example."
        log_info "Veuillez ouvrir et éditer le fichier .env pour renseigner vos clés d'API Notion."
    else
        log_error "Fichier .env.example manquant !"
    fi
else
    log_success "Fichier de configuration .env déjà présent."
fi

echo ""
# 3. Installation des dépendances du projet (node_modules)
if [ ! -d "node_modules" ]; then
    log_info "Le dossier node_modules est manquant."
    if [ "$AUTO_INSTALL" = true ]; then
        log_info "Installation automatique des dépendances npm..."
        npm install
        log_success "Dépendances Next.js installées."
    else
        read -p "Voulez-vous lancer 'npm install' maintenant ? [O/n] " -n 1 -r
        echo ""
        if [[ $REPLY =~ ^[Oo]$ ]] || [[ -z $REPLY ]]; then
            log_info "Installation des dépendances npm..."
            npm install
            log_success "Dépendances Next.js installées avec succès."
        else
            log_warn "Installation des dépendances Next.js ignorée."
        fi
    fi
else
    log_success "Dossier node_modules déjà présent."
fi

echo ""
# 4. Synthèse et démarrage
echo -e "${BOLD}======================================================================${NC}"
log_success "Le projet est configuré et prêt !"
echo ""
echo "Commandes utiles pour démarrer :"
echo -e "  * Lancer en mode de dev local :       ${BOLD}make up${NC} (ou ${BOLD}npm run dev${NC})"
echo -e "  * Peupler le réservoir depuis n8n :   ${BOLD}python3 scripts/populate_reservoir.py${NC}"
echo -e "  * Éteindre les conteneurs :           ${BOLD}make down${NC}"
echo -e "${BOLD}======================================================================${NC}"
