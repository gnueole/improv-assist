#!/usr/bin/env bash
# ==============================================================================
# 🎭 HOUBA HOUBA! — SCRIPT DE CONFIGURATION
# ==============================================================================
# Description : Vérifie les dépendances système, initialise les fichiers .env
#               et installe les paquets de dépendances requis.
# Author      : Éole <hi@eole.me>
# License     : MIT
# ==============================================================================

# Interrompt le script en cas d'erreur
set -e

# Terminal output styling colors (TrueColor / 24-bit ANSI)
ESC_SEQ="\033["
RESET="${ESC_SEQ}0m"
BOLD="${ESC_SEQ}1m"
DIM="${ESC_SEQ}2m"
ITALIC="${ESC_SEQ}3m"
UNDERLINE="${ESC_SEQ}4m"

GREEN="${ESC_SEQ}38;2;74;222;128m"    # Bright Neon Green
BLUE="${ESC_SEQ}38;2;96;165;250m"     # Sky Blue
YELLOW="${ESC_SEQ}38;2;253;224;71m"   # Yellow
RED="${ESC_SEQ}38;2;244;63;94m"       # Rose Red
ORANGE="${ESC_SEQ}38;2;251;146;60m"   # Soft Orange
PURPLE="${ESC_SEQ}38;2;167;139;250m"  # Pastel Purple
CYAN="${ESC_SEQ}38;2;45;212;191m"     # Teal/Cyan
GRAY="${ESC_SEQ}38;2;156;163;175m"     # Medium Gray
DARK_GRAY="${ESC_SEQ}38;2;75;85;99m"  # Dark Gray

# Logger helper functions
log_success() { echo -e "  ${GREEN}✔${RESET}  $1"; }
log_warn()    { echo -e "  ${YELLOW}⚠${RESET}  $1"; }
log_error()   { echo -e "  ${RED}✘${RESET}  $1"; }
log_info()    { echo -e "  ${BLUE}ℹ${RESET}  $1"; }

print_section() {
    echo ""
    echo -e "  ${BOLD}${PURPLE}❯ $1${RESET}"
    echo -e "  ${DARK_GRAY}────────────────────────────────────────────────────────────${RESET}"
}

# Helper to print perfectly aligned lines inside a box of width 70
print_box_line() {
    local border_color="$1"
    local left_pad="$2"
    local content="$3"
    local max_width=70
    
    # Strip ANSI escape codes using portable sed and printf \033
    local esc
    esc=$(printf '\033')
    local clean_content
    clean_content=$(echo -e "$content" | sed "s/${esc}\[[0-9;]*[a-zA-Z]//g")
    local content_len=${#clean_content}
    
    # Adjust for known 2-column wide characters (like 🛠️, 🐸, 🎭, 🍃)
    local emoji_count
    emoji_count=$(echo "$clean_content" | grep -o -E "🛠️|🐸|🎭|🍃" | wc -l || echo 0)
    content_len=$((content_len + emoji_count))
    
    local pad_len=$((max_width - left_pad - content_len))
    if [ $pad_len -lt 0 ]; then
        pad_len=0
    fi
    
    local spaces=""
    if [ $pad_len -gt 0 ]; then
        spaces=$(printf '%*s' "$pad_len" "")
    fi
    
    local indent=""
    if [ $left_pad -gt 0 ]; then
        indent=$(printf '%*s' "$left_pad" "")
    fi
    
    echo -e "  ${border_color}│${RESET}${indent}${content}${spaces}${border_color}│${RESET}"
}

# Resolve project name dynamically from git remote or directory name
REPO_NAME=$(git config --get remote.origin.url 2>/dev/null | sed 's/.*\///; s/\.git$//')
if [ -z "$REPO_NAME" ]; then
    REPO_NAME=$(basename "$(pwd)")
fi
PROJECT_NAME=$(echo "$REPO_NAME" | cut -d'-' -f1 | sed 's/./\u&/')
PROJECT_NAME_UPPER=$(echo "$PROJECT_NAME" | tr '[:lower:]' '[:upper:]')

# Options en ligne de commande
AUTO_INSTALL=false
for arg in "$@"; do
    case $arg in
        -y|--non-interactive|--auto)
            AUTO_INSTALL=true
            shift
            ;;
    esac
done

echo -e "  ${CYAN}┌──────────────────────────────────────────────────────────────────────┐${RESET}"
print_box_line "${CYAN}" 3 "${BOLD}${GREEN}🐸  ${PROJECT_NAME_UPPER} 🐸${RESET} ${BLUE}- SYSTEM CONFIGURATION & INITIALIZATION${RESET}"
echo -e "  ${CYAN}└──────────────────────────────────────────────────────────────────────┘${RESET}"
echo ""

print_section "Vérification des dépendances système"

# Node.js
if command -v node >/dev/null 2>&1; then
    NODE_VERSION=$(node -v | cut -d'v' -f2)
    NODE_MAJOR=$(echo "$NODE_VERSION" | cut -d'.' -f1)
    if [ "$NODE_MAJOR" -lt 20 ]; then
        log_warn "Node.js est installé (v$NODE_VERSION) mais la version 20+ est vivement recommandée."
    else
        log_success "Node.js est installé : v$NODE_VERSION"
    fi
else
    log_error "Node.js n'est pas détecté. Veuillez installer Node.js v20+ pour lancer l'application Next.js."
fi

# npm
if command -v npm >/dev/null 2>&1; then
    NPM_VERSION=$(npm -v)
    log_success "npm est installé : v$NPM_VERSION"
else
    log_error "npm n'est pas détecté."
fi

# Docker
if command -v docker >/dev/null 2>&1; then
    DOCKER_VERSION=$(docker --version | awk '{print $3}' | sed 's/,//')
    log_success "Docker est installé : v$DOCKER_VERSION"
else
    log_warn "Docker n'est pas détecté. Requis pour exécuter l'environnement de dev conteneurisé."
fi

# Docker Compose
if docker compose version >/dev/null 2>&1; then
    log_success "Docker Compose est disponible (docker compose)"
elif command -v docker-compose >/dev/null 2>&1; then
    log_success "Docker Compose est disponible (docker-compose)"
else
    log_warn "Docker Compose n'est pas détecté. Requis pour les raccourcis de développement locaux."
fi

# Python 3 & requests
if command -v python3 >/dev/null 2>&1; then
    PYTHON_VERSION=$(python3 --version | awk '{print $2}')
    log_success "Python 3 est installé : v$PYTHON_VERSION"
    
    if python3 -c "import requests" >/dev/null 2>&1; then
        log_success "Bibliothèque Python 'requests' est présente."
    else
        log_warn "La bibliothèque Python 'requests' est manquante."
        if [ "$AUTO_INSTALL" = true ]; then
            log_info "Installation automatique des packages Python requis..."
            pip3 install -r scripts/requirements.txt || pip install -r scripts/requirements.txt || log_warn "Échec de l'installation automatique. Lancez manuellement : pip install -r scripts/requirements.txt"
        else
            read -p "Voulez-vous installer les dépendances Python (requests) maintenant ? [O/n] " -n 1 -r
            echo ""
            if [[ $REPLY =~ ^[Oo]$ ]] || [[ -z $REPLY ]]; then
                pip3 install -r scripts/requirements.txt || pip install -r scripts/requirements.txt || log_warn "Échec de l'installation. Lancez manuellement : pip install -r scripts/requirements.txt"
            else
                log_warn "Installation des dépendances Python ignorée."
            fi
        fi
    fi
else
    log_warn "Python 3 n'est pas installé. Requis pour le script d'import populate_reservoir.py."
fi

echo ""
print_section "Configuration des fichiers d'environnement"

if [ ! -f ".env" ]; then
    log_warn "Le fichier de configuration .env est introuvable."
    if [ -f ".env.example" ]; then
        cp .env.example .env
        log_success "Fichier .env initialisé avec succès depuis .env.example."
    else
        log_error "Fichier .env.example manquant !"
        exit 1
    fi
else
    log_success "Fichier de configuration .env déjà présent."
fi

# Configuration interactive des clés d'intégration
if [ "$AUTO_INSTALL" = false ]; then
    echo ""
    read -p "Voulez-vous configurer les clés d'intégration Notion/n8n dans le fichier .env maintenant ? [o/N] " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Oo]$ ]]; then
        # Notion API Key
        read -p "Saisissez votre clé d'intégration Notion (NOTION_API_KEY) : " input_notion_key
        if [ ! -z "$input_notion_key" ]; then
            node -e "
              const fs = require('fs');
              let c = fs.readFileSync('.env', 'utf8');
              c = c.includes('NOTION_API_KEY=') 
                ? c.replace(/NOTION_API_KEY=.*/, 'NOTION_API_KEY=\"' + process.argv[1] + '\"') 
                : c + '\nNOTION_API_KEY=\"' + process.argv[1] + '\"';
              fs.writeFileSync('.env', c, 'utf8');
            " "$input_notion_key"
            log_success "NOTION_API_KEY enregistrée."
        fi

        # Notion Database ID
        read -p "Saisissez votre ID de base de données de contraintes Notion (NOTION_DATABASE_ID) : " input_notion_db
        if [ ! -z "$input_notion_db" ]; then
            node -e "
              const fs = require('fs');
              let c = fs.readFileSync('.env', 'utf8');
              c = c.includes('NOTION_DATABASE_ID=') 
                ? c.replace(/NOTION_DATABASE_ID=.*/, 'NOTION_DATABASE_ID=\"' + process.argv[1] + '\"') 
                : c + '\nNOTION_DATABASE_ID=\"' + process.argv[1] + '\"';
              fs.writeFileSync('.env', c, 'utf8');
            " "$input_notion_db"
            log_success "NOTION_DATABASE_ID enregistrée."
        fi

        # X_N8N_TOKEN
        read -p "Saisissez votre jeton de sécurité Webhook n8n (X_N8N_TOKEN) : " input_n8n_token
        if [ ! -z "$input_n8n_token" ]; then
            node -e "
              const fs = require('fs');
              let c = fs.readFileSync('.env', 'utf8');
              c = c.includes('X_N8N_TOKEN=') 
                ? c.replace(/X_N8N_TOKEN=.*/, 'X_N8N_TOKEN=\"' + process.argv[1] + '\"') 
                : c + '\nX_N8N_TOKEN=\"' + process.argv[1] + '\"';
              fs.writeFileSync('.env', c, 'utf8');
            " "$input_n8n_token"
            log_success "X_N8N_TOKEN enregistrée."
        fi
    fi
fi

echo ""
print_section "Installation des dépendances du projet (node_modules)"
if [ ! -d "node_modules" ]; then
    log_info "Le dossier node_modules est manquant."
    if [ "$AUTO_INSTALL" = true ]; then
        log_info "Installation automatique des dépendances npm..."
        npm install
        log_success "Dépendances Next.js installées."
    else
        read -p "Voulez-vous lancer 'npm install' maintenant ? [O/n] " -n 1 -r
        echo ""
        if [[ $REPLY =~ ^[Oo]$ ]] || [[ -z $REPLY ]]; then
            log_info "Installation des dépendances npm..."
            npm install
            log_success "Dépendances Next.js installées avec succès."
        else
            log_warn "Installation des dépendances Next.js ignorée."
        fi
    fi
else
    log_success "Dossier node_modules déjà présent."
fi

echo ""
print_section "Synthèse & Démarrage"
echo -e "  ${GREEN}┌──────────────────────────────────────────────────────────────────────┐${RESET}"
print_box_line "${GREEN}" 3 "${BOLD}${GREEN}✔ ${PROJECT_NAME} configuration complétée avec succès !${RESET}"
echo -e "  ${GREEN}└──────────────────────────────────────────────────────────────────────┘${RESET}"
echo ""
echo -e "  ${BOLD}${PURPLE}Commandes utiles pour démarrer :${RESET}"
echo -e "    ${GRAY}•${RESET} Lancer en mode de dev local :       ${GREEN}make up${RESET} (ou ${GREEN}npm run dev${RESET})"
echo -e "    ${GRAY}•${RESET} Peupler le réservoir depuis n8n :   ${GREEN}python3 scripts/populate_reservoir.py${RESET}"
echo -e "    ${GRAY}•${RESET} Éteindre les conteneurs :           ${GREEN}make down${RESET}"
echo ""
